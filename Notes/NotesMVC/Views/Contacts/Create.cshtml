@model Notes.Domain.Contact
@{
    ViewData["Title"] = "Добавить контакт";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Добавить контакт</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Имя</label>
            <input asp-for="Name" class="form-control" placeholder="Введите имя" required />
        </div>
        <div class="col-md-6">
            <label asp-for="Surname" class="form-label">Фамилия</label>
            <input asp-for="Surname" class="form-control" placeholder="Введите фамилию" required />
        </div>
        <div class="col-md-12">
            <label asp-for="Email" class="form-label">Электронная почта</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Введите email" required />
        </div>
        <div class="col-md-6">
            <label asp-for="Phone1" class="form-label">Телефон 1</label>
            <input asp-for="Phone1" type="tel" class="form-control" placeholder="Введите телефон 1" required />
        </div>
        <div class="col-md-6">
            <label asp-for="Phone2" class="form-label">Телефон 2</label>
            <input asp-for="Phone2" type="tel" class="form-control" placeholder="Введите телефон 2" />
        </div>
        <div class="col-md-12">
            <label asp-for="Description" class="form-label">Описание</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Введите описание"></textarea>
        </div>
        <div class="col-md-12 text-center">
            <button type="submit" class="btn btn-primary btn-lg">Добавить</button>
        </div>
    </form>
</div>