    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Notes.Domain.Contact

@{
    ViewData["Title"] = "Найти контакт";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Найти контакт по Id</h1>

    <!-- Сообщение об ошибке -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Пустая зона, которая будет серой на старте -->
    <div id="contacts-zone" class="mt-4 p-3 border rounded" style="background-color: #f0f0f0; height: calc(20 * 1.5em); overflow-y: auto;">
        @if (Model != null)
        {
            <div class="contact-item">
                <h5>@Model.Name @Model.Surname</h5>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Телефон 1:</strong> @Model.Phone1</p>
                <p><strong>Телефон 2:</strong> @Model.Phone2</p>
                <p><strong>Описание:</strong> @Model.Description</p>
            </div>
        }
        else
        {
            <p class="text-muted">Результаты будут отображаться здесь после отправки формы.</p>
        }
    </div>

    <!-- Форма с полем для ввода Id -->
    <div class="row justify-content-center mt-3">
        <div class="col-md-6 text-center">
            <form method="post">
                <div class="mb-3">
                    <label for="contactId" class="form-label">Введите Id контакта</label>
                    <input type="number" name="id" id="contactId" class="form-control" placeholder="Введите Id" required />
                </div>
                <button type="submit" class="btn btn-primary btn-lg">Найти</button>
            </form>
        </div>
    </div>

</div>