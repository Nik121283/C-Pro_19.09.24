    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Notes App</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" />

    </head>
    <body>
        <header class="bg-primary text-white p-3 mb-3">
            <div class="container">
                <h1>Notes App</h1>
                <nav class="navbar navbar-expand-lg navbar-dark">
                    <div class="container-fluid">
                        <div class="d-flex gap-2">
                            <a class="btn btn-light" href="/Notes/Index">Заметки</a>
                            <a class="btn btn-light" href="/Contacts/Index">Контакты</a>
                            <a class="btn btn-light" href="/Tags/Index">Теги</a>
                        </div>
                    </div>
                </nav>
            </div>
        </header>
        <main class="container">
            @RenderBody()
        </main>
        <footer class="bg-light text-center text-muted py-3">
            <div class="container">
                <p>&copy; @DateTime.Now.Year Notes App</p>
            </div>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
}
